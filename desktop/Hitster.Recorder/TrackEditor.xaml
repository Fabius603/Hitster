<UserControl x:Class="Hitster.Recorder.TrackEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Panel}">
    <StackPanel>
      <DockPanel Margin="0,0,0,14">
        <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="Aufnehmen" Click="Record_Click" Margin="12,0,0,0" Padding="12,7"/>
        <StackPanel><TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="19"/><TextBlock x:Name="State" Text="Noch keine Aufnahme" Foreground="#6D748B" Margin="0,5,0,0"/></StackPanel>
      </DockPanel>
      <Border Background="#F3F2FA" CornerRadius="8" ClipToBounds="True">
        <Canvas x:Name="Waveform" Height="74" SizeChanged="Waveform_SizeChanged" IsHitTestVisible="False"/>
      </Border>
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Start" VerticalAlignment="Center"/>
        <Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Trim_Changed" IsEnabled="False" AutomationProperties.Name="Schnittanfang" VerticalAlignment="Center"/>
        <TextBlock x:Name="StartTime" Grid.Column="2" Text="00:00.00" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Text="Ende" Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0"/>
        <Slider x:Name="EndSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Trim_Changed" IsEnabled="False" AutomationProperties.Name="Schnittende" VerticalAlignment="Center" Margin="0,12,0,0"/>
        <TextBlock x:Name="EndTime" Grid.Row="1" Grid.Column="2" Text="00:00.00" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0"/>
      </Grid>
      <DockPanel Margin="0,18,0,0">
        <Button x:Name="PlayButton" Content="▶  Abspielen" Click="Play_Click" IsEnabled="False" Padding="12,8"/>
        <Button x:Name="RewindButton" Content="↺" Click="Rewind_Click" ToolTip="Zurück zum Schnittanfang" AutomationProperties.Name="Zurück zum Schnittanfang" IsEnabled="False" Padding="12,8"/>
        <TextBlock x:Name="SelectionInfo" Text="Ausschnitt: —" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#6D748B"/>
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
